commands:
  01_install_playwright_deps:
    command: |
      # Playwright 브라우저 의존성 설치
      dnf install -y alsa-lib atk cups-libs gtk3 libXcomposite libXcursor libXdamage libXext libXi libXrandr libXScrnSaver libXtst pango at-spi2-atk libdrm mesa-libgbm || \
      yum install -y alsa-lib atk cups-libs gtk3 libXcomposite libXcursor libXdamage libXext libXi libXrandr libXScrnSaver libXtst pango at-spi2-atk libdrm mesa-libgbm
    ignoreErrors: true

container_commands:
  01_install_playwright_browsers:
    command: |
      source /var/app/venv/*/bin/activate
      playwright install chromium
    ignoreErrors: true
